<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="l10n_gs_animations_animations_title">애니메이션</string>
    <string name="gs_use_magic_item_animation_title">마법 아이템 시전 애니메이션 사용</string>
    <string name="gs_use_magic_item_animation_summary">주문처럼 마법 아이템을 사용할 때도 시전 애니메이션을 사용합니다.</string>
    <string name="gs_use_additional_animation_sources_title">추가 애니메이션 소스 사용</string>
    <string name="gs_use_additional_animation_sources_summary">Animations 폴더에서 그룹별 KF 파일과 스켈레톤 파일을 불러옵니다.</string>
    <string name="gs_weapon_sheating_title">무기 수납</string>
    <string name="gs_weapon_sheating_summary">수납한 무기를 화살통과 칼집까지 포함해 표시합니다. 수정된 에셋이 필요합니다.</string>
    <string name="gs_shield_sheating_title">방패 수납</string>
    <string name="gs_shield_sheating_summary">수납한 방패를 표시합니다. 수정된 에셋이 필요합니다.</string>
    <string name="gs_enable_graphics_herbalism_title">시각적 약초 채집 사용</string>
    <string name="gs_enable_graphics_herbalism_summary">지원되는 채집 컨테이너는 메뉴를 여는 대신 채집 상태가 그래픽으로 표시됩니다.</string>
    <string name="gs_smooth_movement_title">부드러운 이동</string>
    <string name="gs_smooth_movement_summary">NPC와 플레이어의 이동을 더 부드럽게 합니다. ‘이동 방향으로 몸 돌리기’와 함께 사용하는 것을 권장합니다.</string>
    <string name="gs_smooth_animation_transitions_title">부드러운 애니메이션 전환</string>
    <string name="gs_smooth_animation_transitions_summary">호환되는 애니메이션 전환을 부드럽게 혼합합니다. OpenMW 0.49에서 추가되었으며 기본값은 꺼짐입니다.</string>
    <string name="gs_turn_to_movement_direction_title">이동 방향으로 몸 돌리기</string>
    <string name="gs_turn_to_movement_direction_summary">옆걸음과 대각선 이동에 영향을 줍니다. 켜면 캐릭터가 이동 방향에 맞춰 하체를 돌리고 상체는 일부만 따라가며, 머리는 시선 방향을 유지합니다. 전투 중에는 대각선 이동에만 적용되고 비전투 중에는 좌우 직선 이동에도 적용됩니다. 수영할 때도 이동 방향에 따라 몸 전체가 위아래로 기울어집니다.</string>
    <string name="l10n_gs_engine_engine_title">엔진</string>
    <string name="gs_groundcover_handling_title">그라운드커버 처리</string>
    <string name="gs_groundcover_handling_summary">%s\n그라운드커버 모드의 렌더링 거리와 밀도 등 전용 설정을 사용합니다. 그라운드커버 메시에는 애니메이션을 허용하고 충돌을 비활성화합니다. 그라운드커버 모드는 모드 관리자에서 ‘그라운드커버’ 탭으로 불러와야 합니다.</string>
    <string name="gs_groundcover_handling_dialogtitle">그라운드커버 처리</string>
    <string name="gs_groundcover_point_lighting_title">그라운드커버 점광원 조명</string>
    <string name="gs_groundcover_point_lighting_summary">OpenMW 0.51: 주변 램프와 기타 점광원이 풀을 비추도록 합니다. GPU 성능을 아끼려면 끄세요.</string>
    <string name="gs_build_navmesh_title">월드 지오메트리용 내비메시 생성</string>
    <string name="gs_build_navmesh_summary">내비게이터를 사용합니다. 켜면 백그라운드 스레드가 월드 지오메트리용 내비메시를 만들고 길찾기에 사용합니다. 끄면 패스그리드만 사용합니다. 싱글 코어 CPU에서는 실내를 나가거나 외부 지역을 이동할 때 성능 저하가 클 수 있습니다. 멀티 코어에서는 다른 설정과 시스템 성능에 따라 내비메시 갱신 지연이 달라질 수 있습니다. 내비메시가 주변에 만들어지기 전에는 NPC와 생물이 경로를 찾지 못할 수 있습니다.</string>
    <string name="gs_write_navmesh_title">내비메시 캐시를 디스크에 저장</string>
    <string name="gs_write_navmesh_summary">내비메시 타일을 디스크에 캐시합니다.</string>
    <string name="l10n_gs_engine_threading_title">스레딩</string>
    <string name="gs_navmesh_threads_title">백그라운드 내비메시 스레드</string>
    <string name="gs_navmesh_threads_summary">내비메시 갱신에 사용할 백그라운드 스레드 수입니다. 1~8로 조절할 수 있으며 기본값은 1입니다.</string>
    <string name="gs_physics_threads_title">백그라운드 물리 스레드</string>
    <string name="gs_physics_threads_summary">물리 갱신에 사용할 백그라운드 스레드 수입니다. 1~8로 조절할 수 있으며 기본값은 1입니다.</string>
    <string name="gs_preload_threads_title">백그라운드 미리 불러오기 스레드</string>
    <string name="gs_preload_threads_summary">미리 불러오기 작업에 사용할 스레드 수입니다. 1~8로 조절할 수 있으며 기본값은 1입니다.</string>
    <string name="l10n_gs_bug_fixes_miscellaneous_title">기타</string>
    <string name="gs_merchant_equipping_fix_title">상인 장비 착용 수정</string>
    <string name="gs_merchant_equipping_fix_summary">상인이 플레이어에게서 산 아이템을 착용하지 않도록 합니다.</string>
    <string name="gs_trainers_bs_title">트레이너가 기본 스킬 수치로 훈련 스킬 선택</string>
    <string name="gs_trainers_bs_summary">트레이너가 기본 스킬 수치만 사용해 훈련 가능한 스킬을 결정합니다. 거래 스킬 증가 효과 때문에 거래가 훈련 목록에 강제로 포함되는 일을 막습니다.</string>
    <string name="l10n_gs_shadows_general_title">일반</string>
    <string name="gs_enable_shadows_title">그림자 사용</string>
    <string name="gs_enable_shadows_summary">OpenMW 실시간 그림자 매핑을 사용합니다. 셰이더 렌더링 경로를 사용하므로 성능이 낮아질 수 있습니다.</string>
    <string name="l10n_gs_shadows_shadow_casters_title">그림자 생성 대상</string>
    <string name="gs_player_shadows_title">플레이어 그림자</string>
    <string name="gs_player_shadows_summary">플레이어 캐릭터가 그림자를 만들도록 합니다.</string>
    <string name="gs_actor_shadows_title">액터 그림자</string>
    <string name="gs_actor_shadows_summary">NPC와 생물이 그림자를 만들도록 합니다.</string>
    <string name="gs_object_shadows_title">오브젝트 그림자</string>
    <string name="gs_object_shadows_summary">월드 오브젝트가 그림자를 만들도록 합니다.</string>
    <string name="gs_terrain_shadows_title">지형 그림자</string>
    <string name="gs_terrain_shadows_summary">지형이 그림자를 만들도록 합니다.</string>
    <string name="gs_indoor_shadows_title">실내 그림자</string>
    <string name="gs_indoor_shadows_summary">실내에서 그림자를 사용합니다. Morrowind 데이터의 한계 때문에 실내에서는 액터만 그림자를 만들 수 있습니다.</string>
    <string name="l10n_gs_shadows_quality_distance_title">품질 및 거리</string>
    <string name="gs_shadow_quality_title">그림자 품질</string>
    <string name="gs_shadow_quality_dialogtitle">그림자 품질</string>
    <string name="gs_shadow_distance_title">그림자 거리</string>
    <string name="gs_shadow_distance_dialogtitle">그림자 거리</string>
    <string name="l10n_gs_miscellaneous_saves_title">저장</string>
    <string name="gs_add_time_to_saves_title">저장 파일에 플레이 시간 표시</string>
    <string name="gs_add_time_to_saves_summary">불러오기 메뉴에서 각 저장 파일에 플레이한 시간을 표시할지 정합니다.</string>
    <string name="gs_maximum_quicksaves_title">최대 빠른 저장 수</string>
    <string name="gs_maximum_quicksaves_summary">보관할 빠른 저장 파일의 최대 개수입니다.</string>
    <string name="gs_maximum_quicksaves_dialogtitle">최대 빠른 저장 수</string>
    <string name="l10n_gs_visuals_terrain_title">지형</string>
    <string name="gs_object_paging_min_size_title">오브젝트 페이징 최소 크기</string>
    <string name="gs_object_paging_min_size_summary">장면에 표시되기 위한 오브젝트의 최소 크기를 정합니다. 0.01~1.00 범위에서 0.01 단위로 조절할 수 있습니다.</string>
    <string name="gs_distant_land_title">원거리 지형</string>
    <string name="gs_distant_land_summary">켜면 페이징과 LOD 알고리즘을 사용해 전체 지형을 표시합니다. 끄면 불러온 셀의 지형만 표시합니다.</string>
    <string name="gs_active_grid_object_paging_title">활성 그리드 오브젝트 페이징</string>
    <string name="gs_active_grid_object_paging_summary">활성 셀 그리드에 오브젝트 페이징을 사용합니다.</string>
    <string name="l10n_gs_visuals_graphics_title">그래픽</string>
    <string name="pref_physicsfps2_summary">%s FPS</string>
    <string name="l10n_gs_visuals_shaders_title">셰이더</string>
    <string name="gs_auto_use_object_normal_maps_title">오브젝트 노멀 맵 자동 사용</string>
    <string name="gs_auto_use_object_normal_maps_summary">켜면 이름 규칙에 맞는 노멀 맵을 자동으로 찾아 사용합니다. 예를 들어 기본 텍스처가 foo.dds라면 노멀 맵은 foo_n.dds 형식이어야 합니다. 끄면 메시 파일(.nif 또는 .osg)에 명시된 노멀 맵만 사용합니다. 오브젝트에 적용됩니다.</string>
    <string name="gs_auto_use_object_specular_maps_title">오브젝트 스페큘러 맵 자동 사용</string>
    <string name="gs_auto_use_object_specular_maps_summary">켜면 이름 규칙에 맞는 스페큘러 맵을 자동으로 찾아 사용합니다. 예를 들어 기본 텍스처가 foo.dds라면 foo_spec.dds 형식입니다. 끄면 메시 파일에 명시된 맵만 사용합니다. 오브젝트에 적용됩니다.</string>
    <string name="gs_auto_use_terrain_normal_maps_title">지형 노멀 맵 자동 사용</string>
    <string name="gs_auto_use_terrain_normal_maps_summary">‘오브젝트 노멀 맵 자동 사용’과 같은 방식이며 지형에 적용됩니다.</string>
    <string name="gs_auto_use_terrain_specular_maps_title">지형 스페큘러 맵 자동 사용</string>
    <string name="gs_auto_use_terrain_specular_maps_summary">지형 스페큘러 맵 이름 규칙에 맞는 파일이 있으면 디퓨즈 스페큘러 맵으로 사용합니다. RGB 채널에는 레이어 색상을, 알파 채널에는 스페큘러 배수를 넣어야 합니다.</string>
    <string name="gs_bump_map_local_lighting_title">범프/반사 맵 로컬 조명</string>
    <string name="gs_bump_map_local_lighting_summary">환경 맵 반사가 조명의 영향을 받도록 해 범프 맵 오브젝트가 어두운 곳에서 빛나는 현상을 줄입니다. Morrowind Code Patch의 대응 옵션과 같은 동작이며 적용 대상 오브젝트는 셰이더를 사용합니다.</string>
    <string name="l10n_gs_visuals_fog_title">안개</string>
    <string name="gs_radial_fog_title">방사형 안개</string>
    <string name="gs_radial_fog_summary">클리핑 평면 기준이 아니라 실제 시점과의 거리로 안개를 계산해 화면 가장자리의 왜곡을 줄입니다. 넓은 시야각에서 특히 자연스럽게 보입니다.</string>
    <string name="gs_exponential_fog_title">지수형 안개</string>
    <string name="gs_exponential_fog_summary">안개 계산에 지수 공식을 사용할지 정합니다.</string>
    <string name="gs_sky_blending_title">하늘 블렌딩</string>
    <string name="gs_sky_blending_summary">클리핑 평면을 하늘과 혼합해 가릴지 정합니다.</string>
    <string name="l10n_gs_visuals_post_processing_title">후처리</string>
    <string name="gs_soft_particles_title">소프트 파티클</string>
    <string name="gs_soft_particles_summary">반투명 파티클 시스템과 불투명 지오메트리가 만나는 경계를 부드럽게 합니다.</string>
    <string name="gs_transparent_postpass_title">투명 오브젝트 포스트패스</string>
    <string name="gs_transparent_postpass_summary">투명 깊이 포스트패스를 사용합니다. 고정 임계값의 알파 클리핑을 강제해 투명 오브젝트를 다시 렌더링합니다.</string>
    <string name="pref_game_settings_title">게임 설정</string>
    <string name="pref_game_settings_summary">게임플레이, 화면, 그림자, 애니메이션, 인터페이스 및 엔진 설정을 구성합니다.</string>
    <string name="pref_mods_summary">OpenMW에 모드를 추가합니다.</string>
    <string name="pref_omw050_controller_menus_title">컨트롤러 메뉴</string>
    <string name="pref_omw050_controller_menus_summary">OpenMW 0.51의 게임패드 최적화 메뉴 탐색을 사용합니다.</string>
    <string name="pref_omw050_controller_tooltips_title">컨트롤러 툴팁</string>
    <string name="pref_omw050_controller_tooltips_summary">R3를 누르지 않아도 아이템 툴팁을 항상 표시합니다.</string>
    <string name="pref_omw051_controller_trigger_thresholds_title">컨트롤러 트리거 감도</string>
    <string name="pref_omw051_controller_trigger_thresholds_dialogtitle">컨트롤러 트리거 감도</string>
    <string name="pref_controls_summary">화면 터치 조작 방식을 설정합니다.</string>
    <string name="gs_framerate_limit_summary">%s FPS</string>
    <string name="l10n_settings_audio_title">오디오</string>
    <string name="pref_omw050_doppler_title">도플러 효과</string>
    <string name="pref_omw050_doppler_summary">OpenMW 0.51 위치 기반 오디오의 도플러 효과를 사용합니다(계수 0.25).</string>
    <string name="pref_omw050_camera_listener_title">카메라를 오디오 청취 위치로 사용</string>
    <string name="pref_omw050_camera_listener_summary">3D 오디오 청취 위치로 플레이어 대신 카메라 위치를 사용합니다.</string>
    <string name="pref_skip_gui_title">런처 GUI 건너뛰기</string>
    <string name="pref_skip_gui_summary">앱 실행 중 ‘볼륨 크게’ 버튼을 누르고 있으면 런처를 다시 표시할 수 있습니다.</string>
    <string name="game_settings_game_mechanics_title">게임플레이</string>
    <string name="game_settings_visuals_title">화면</string>
    <string name="game_settings_shadows_title">그림자</string>
    <string name="game_settings_animations_title">애니메이션</string>
    <string name="game_settings_interface_title">인터페이스</string>
    <string name="game_settings_engine_title">엔진</string>
    <string name="l10n_gs_interface_ui_title">UI</string>
    <string name="gs_show_owned_title">소유권 표시</string>
    <string name="gs_show_owned_dialogtitle">소유권 표시</string>
    <string name="gs_show_effect_duration_title">효과 지속시간 표시</string>
    <string name="gs_show_effect_duration_summary">마법 효과와 조명의 남은 지속시간을 표시합니다. 마법 효과 위에 커서를 올리면 툴팁에 남은 시간이 표시됩니다.</string>
    <string name="gs_show_enchant_chance_title">마법부여 성공 확률 표시</string>
    <string name="gs_show_enchant_chance_summary">마법부여 메뉴에 성공 확률을 표시할지 정합니다.</string>
    <string name="gs_show_melee_info_title">근접 무기 정보 표시</string>
    <string name="gs_show_melee_info_summary">근접 무기의 사거리와 속도를 아이템 툴팁에 표시합니다.</string>
    <string name="gs_show_projectile_damage_title">투사체 피해 표시</string>
    <string name="gs_show_projectile_damage_summary">화살과 볼트의 추가 피해를 아이템 툴팁에 표시합니다.</string>
    <string name="gs_change_dialogue_topic_color_title">대화 토픽 색상 변경</string>
    <string name="gs_change_dialogue_topic_color_summary">현재 NPC에게만 해당하는 토픽이거나 이전에 본 토픽이면 다른 색으로 표시합니다. 색상은 settings.cfg에서 변경할 수 있습니다.</string>
    <string name="gs_stretch_menu_background_title">메뉴 배경 늘이기</string>
