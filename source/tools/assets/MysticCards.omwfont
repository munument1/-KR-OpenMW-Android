<MyGUI type="Resource" version="1.1">
    <Resource type="ResourceTrueTypeFont">
        <!-- RC10l Korean default: keep OpenMW's MysticCards slot, render with Galmuri11 Regular. -->
        <Property key="Source" value="Galmuri11.ttf"/>
        <Property key="Antialias" value="false"/>
        <Property key="SubstituteCode" value="95"/>
        <Property key="TabWidth" value="8"/>
        <Property key="OffsetHeight" value="0"/>
        <Property key="Resolution" value="68"/>
        <Codes>
            <Code range="33 65535"/>
        </Codes>
    </Resource>
</MyGUI>
